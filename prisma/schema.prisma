generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm" // Keep this, your project is ESM
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String?
  contact  String?
  skinType String?   @map("skin_type")
  bookings Booking[]
  incomes  Income[]

  @@map("clients")
}

model Booking {
  id         Int              @id @default(autoincrement())
  clientId   Int?             @map("client_id")
  location   String?
  totalPrice Float?           @map("total_price")
  deposit    Float?
  status     String?
  date       DateTime?
  notes      String?
  client     Client?          @relation(fields: [clientId], references: [id])
  incomes    Income[]
  services   BookingService[]

  @@map("bookings")
}

model Inventory {
  id         Int       @id @default(autoincrement())
  name       String?
  brand      String?
  quantity   Float?
  category   String?
  expiryDate DateTime? @map("expiry_date") @db.Date
  expenses   Expense[]

  @@map("inventories")
}

model Income {
  id            Int       @id @default(autoincrement())
  bookingId     Int?      @map("booking_id")
  clientId      Int?      @map("client_id")
  source        String?
  description   String?
  amount        Float?
  paymentMethod String?   @map("payment_method")
  paymentStatus String?   @map("payment_status")
  date          DateTime?
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  client        Client?   @relation(fields: [clientId], references: [id])

  @@map("income")
}

model Expense {
  id            Int        @id @default(autoincrement())
  inventoryId   Int?       @map("inventory_id")
  category      String?
  description   String?
  amount        Float?
  paymentMethod String?    @map("payment_method")
  supplier      String?
  receiptNo     String?    @map("receipt_no")
  date          DateTime?
  inventory     Inventory? @relation(fields: [inventoryId], references: [id])

  @@map("expenses")
}

model Service {
  id              Int              @id @default(autoincrement())
  name            String
  category        String
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  durationMinutes Int
  isActive        Boolean          @default(true)
  bookingServices BookingService[]
}

model BookingService {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)
}

model Report {
  id            Int      @id @default(autoincrement())
  reportType    String
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  totalIncome   Decimal  @db.Decimal(12, 2)
  totalExpenses Decimal  @db.Decimal(12, 2)
  netProfit     Decimal  @db.Decimal(12, 2)
  totalBookings Int
  generatedBy   String?
  createdAt     DateTime @default(now())
}
